{
  "name": "lidless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lidless: a narrative adventure in a world run by a polite AI. Web first; iOS, Android and desktop from the same build.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "shot": "node scripts/shot.mjs",
    "play": "node scripts/play.mjs",
    "perf": "vite build --logLevel warn && node scripts/perf.mjs",
    "asset": "node tools/pipeline/cli.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "onnxruntime-web": "^1.30.0",
    "puppeteer-core": "25.12.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  },
  "dependencies": {
    "inkjs": "2.4.0"
  }
}
